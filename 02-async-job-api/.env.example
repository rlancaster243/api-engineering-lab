DATABASE_URL=postgresql://postgres:postgres@localhost:5433/async_job_api_lab

# Idempotency-Key needs no setting: the 255-character cap and the fingerprint form are
# protocol constants shared by every instance, not deployment config.

# Worker (optional; defaults shown)
WORKER_POLL_SECONDS=1.0
LEASE_SECONDS=60
RETRY_BACKOFF_SECONDS=5
MAX_RETRY_BACKOFF_SECONDS=300
EFFECT_RECONCILE_GRACE_SECONDS=30
