# Copy to .env and adjust for your local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rest_api_lab

# local_dev serves every request as the seeded development owner. It is accepted only
# with APP_ENV=local or APP_ENV=test; the default, external_jwt, rejects all item
# requests until principal resolution lands (spec section 5.3).
AUTH_MODE=local_dev
APP_ENV=local

# Signs pagination cursors (ADR 0007). At least 32 bytes; generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Intentionally empty: the application refuses to start without a real key.
CURSOR_SIGNING_KEY=

# Token verification, required only when AUTH_MODE=external_jwt (ADR 0005). Example values:
# OIDC_ISSUER=https://idp.example.com/
# OIDC_AUDIENCE=rest-api-lab
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Optional, defaults shown (algorithms: RS256, PS256, ES256 only):
# OIDC_ALGORITHMS=RS256
# OIDC_LEEWAY_SECONDS=30
# OIDC_JWKS_CACHE_SECONDS=300
# OIDC_REQUIRED_SCOPE=
