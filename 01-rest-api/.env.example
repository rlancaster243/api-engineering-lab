# Copy to .env and adjust for your local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rest_api_lab

# Signs pagination cursors (ADR 0007). At least 32 bytes; generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Intentionally empty: the list route (PR-04) will refuse to start without a real key.
CURSOR_SIGNING_KEY=
